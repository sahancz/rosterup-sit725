# Copy this file to .env and adjust if needed. .env itself is gitignored.
MONGO_URI=mongodb://127.0.0.1:27017/RUDatabase
PORT=3000

# Secret used to sign login JWTs. Use any long random string locally;
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Email for sending workplace invites (FR-24). Leave SMTP_HOST unset to use a
# free Ethereal test inbox: emails aren't delivered, but the dashboard shows a
# "View email" link to open each one. To deliver for real (e.g. Gmail with an
# app password: https://myaccount.google.com/apppasswords), set:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM="RosterUp <you@gmail.com>"

# Public address used in links inside emails. Defaults to the address the
# request came in on (e.g. http://localhost:3000).
# APP_BASE_URL=https://your-deployed-app.example.com
